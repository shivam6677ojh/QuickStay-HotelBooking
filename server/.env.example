# QuickStay server environment example
# Copy to `.env` in the server folder and fill the values.

# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/quickstay

# Clerk (server-side). The project may expect CLERK_API_KEY or CLERK_SECRET_KEY.
CLERK_API_KEY=sk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# Email (Nodemailer - using Brevo/Sendinblue)
SENDER_EMAIL=your-email@example.com
SMTP_USER=your_brevo_smtp_login
SMTP_PASS=your_brevo_smtp_password

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AI concierge (Groq / LLaMA 3 70B)
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama3-70b-8192
# Gemini support (either key name works in code)
GENIE_API_KEY=AIza...
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-1.5-flash
# Optional override if Groq exposes a new endpoint
# GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# Rate limiting (optional overrides)
# Global API limiter: defaults to 300 req/min per IP
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# AI chat limiter: defaults to 20 req/min per IP
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=20

# Admin promotion token (use only for initial setup; keep secret)
ADMIN_PROMOTE_TOKEN=change_this_to_a_secret_value

# Notes:
# - Some files in the repo use slightly different env names (e.g. `ClERK_WEBHOOK_SECRET` or `SMPT_USER`).
#   Verify the exact variable names in `server/configs` and `server/server.js` and adjust accordingly.
